{
  "name": "anyfork-workspace",
  "version": "0.1.5",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "anyfork-workspace",
      "version": "0.1.5",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@floatfu-true/anyfork-cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@floatfu-true/anyfork-core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@floatfu-true/anyfork-cli",
      "version": "0.1.5",
      "license": "MIT",
      "dependencies": {
        "@floatfu-true/anyfork-core": "0.1.5"
      },
      "bin": {
        "anyfork": "src/index.js"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/core": {
      "name": "@floatfu-true/anyfork-core",
      "version": "0.1.5",
      "license": "MIT",
      "engines": {
        "node": ">=22"
      }
    }
  }
}
